# Copy to .env and fill in. Do NOT commit .env (it is gitignored).

# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/crewbrain?schema=public
# Neon:   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The full URL the app is served from. Local dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# Invite code required to register a MANAGER account. Crew accounts need no code.
MANAGER_INVITE_CODE="BALLIN"

# Twilio — only needed for the manager mass-SMS feature. Leave blank to disable.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
