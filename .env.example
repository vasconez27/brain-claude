# Copy this file to .env and fill in the values.
# The dev-setup script (scripts/dev-setup.sh) does this for you automatically.

# PostgreSQL connection string.
# Matches the database started by docker-compose.yml in this repo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crewbrain?schema=public"

# NextAuth session secret. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-random-secret"

# Base URL of the app (used by NextAuth for callbacks).
NEXTAUTH_URL="http://localhost:3000"

# Invite code required to register a MANAGER account. Pick any value for local dev.
MANAGER_INVITE_CODE="let-me-in"

# Twilio credentials for mass SMS (optional for local dev — SMS is skipped if unset).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Google OAuth (optional — enables "Sign in with Google" when both are set).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
