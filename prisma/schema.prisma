generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  CREW
}

enum ShiftStatus {
  OPEN
  FILLED
  CANCELLED
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String?
  pin           String?   @unique
  role          Role      @default(CREW)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdShifts     Shift[]           @relation("ShiftManager")
  sentMessages      Message[]
  shiftAssignments  ShiftAssignment[]
  expenses          Expense[]
  accounts          Account[]
  sessions          Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Shift {
  id          String      @id @default(cuid())
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime
  payRate     Float
  status      ShiftStatus @default(OPEN)
  managerId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  manager     User              @relation("ShiftManager", fields: [managerId], references: [id])
  assignments ShiftAssignment[]
}

model ShiftAssignment {
  id          String             @id @default(cuid())
  shiftId     String
  userId      String
  status      ConfirmationStatus @default(PENDING)
  hoursWorked Float?
  assignedAt  DateTime           @default(now())
  confirmedAt DateTime?

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  subject    String?
  body       String   @db.Text
  recipients String[]
  sentAt     DateTime @default(now())
  twilioSid  String?

  sender User @relation(fields: [senderId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  description String
  amount      Float
  category    String
  date        DateTime
  receipt     String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
